<div class="cookie-banner" id="cookieBanner">
    <div class="cookie-content">
        <p>Utilizamos cookies propias y de terceros para analizar el uso de la web. <a href="cookies.html">Más información</a></p>
        <div class="cookie-buttons">
            <button class="cookie-btn reject" onclick="setCookieConsent(false)">Rechazar</button>
            <button class="cookie-btn accept" onclick="setCookieConsent(true)">Aceptar</button>
        </div>
    </div>
</div>

<script>
  function toggleMenu() {
      const menu = document.getElementById('mobileMenu');
      const hamburger = document.querySelector('.hamburger');
      if (menu && hamburger) {
          menu.classList.toggle('active');
          hamburger.classList.toggle('active');
          document.body.style.overflow = menu.classList.contains('active') ? 'hidden' : '';
      }
  }

  // Barra de progreso
  var prog = document.getElementById('prog');
  window.addEventListener('scroll', function(){
      var d = document.documentElement;
      var alto = d.scrollHeight - d.clientHeight;
      if (prog) prog.style.width = (alto > 0 ? d.scrollTop / alto * 100 : 0) + '%';
  }, {passive:true});

  // Revelado al hacer scroll
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(es){
      es.forEach(function(e,i){ if(e.isIntersecting){ setTimeout(function(){e.target.classList.add('on')}, i*90); io.unobserve(e.target);} });
    }, {threshold:.12, rootMargin:'0px 0px -40px 0px'});
    document.querySelectorAll('.rv').forEach(function(el){ io.observe(el); });
  } else {
    document.querySelectorAll('.rv').forEach(function(el){ el.classList.add('on'); });
  }

  // Cookies & Analytics
  function setCookieConsent(accepted) {
      const expires = new Date();
      expires.setFullYear(expires.getFullYear() + 1);
      document.cookie = 'cookie_consent=' + (accepted ? 'accepted' : 'rejected') + ';expires=' + expires.toUTCString() + ';path=/;SameSite=Lax';
      document.getElementById('cookieBanner').classList.remove('active');
      if (accepted) loadAnalytics();
  }
  function getCookieConsent() {
      const match = document.cookie.match(/cookie_consent=([^;]+)/);
      return match ? match[1] : null;
  }
  function loadAnalytics() {
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-MWTDJLNC');
  }

  // ═══ Seguimiento: esta página ES la conversión ═══
  window.dataLayer = window.dataLayer || [];

  document.addEventListener('DOMContentLoaded', function() {
      const consent = getCookieConsent();
      if (!consent) { document.getElementById('cookieBanner').classList.add('active'); }
      else if (consent === 'accepted') { loadAnalytics(); }

      document.querySelectorAll('.mobile-menu-link').forEach(function(link){
          link.addEventListener('click', function(){
              const menu = document.getElementById('mobileMenu');
              const hamburger = document.querySelector('.hamburger');
              if (menu) menu.classList.remove('active');
              if (hamburger) hamburger.classList.remove('active');
              document.body.style.overflow = '';
          });
      });
      const mobileMenu = document.getElementById('mobileMenu');
      if (mobileMenu) {
          mobileMenu.addEventListener('click', function(e){ if (e.target === this) toggleMenu(); });
      }

      // De qué página venía el formulario
      var origen = 'desconocido';
      try {
          var p = new URLSearchParams(window.location.search).get('origen');
          if (p) { origen = p; }
          else if (document.referrer) {
              var ref = new URL(document.referrer);
              if (ref.hostname === window.location.hostname) {
                  origen = ref.pathname.split('/').pop().replace('.html','') || 'index';
              }
          }
      } catch(e) {}

      window.dataLayer.push({ event: 'lead_confirmado', origen: origen });

      document.querySelectorAll('[data-canal]').forEach(function(a) {
          a.addEventListener('click', function() {
              window.dataLayer.push({ event: 'contacto_click', canal: a.getAttribute('data-canal'), pagina: 'gracias' });
          });
      });
      document.querySelectorAll('[data-linea]').forEach(function(a) {
          a.addEventListener('click', function() {
              window.dataLayer.push({ event: 'salida_linea', linea: a.getAttribute('data-linea'), pagina: 'gracias' });
          });
      });
  });
</script>
</body>
</html>
