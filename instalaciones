<script>
  // Toggle mobile menu
  function toggleMenu() {
      const menu = document.getElementById('mobileMenu');
      const hamburger = document.querySelector('.hamburger');
      if (menu && hamburger) {
          menu.classList.toggle('active');
          hamburger.classList.toggle('active');
          document.body.style.overflow = menu.classList.contains('active') ? 'hidden' : '';
      }
  }

  // Nav scroll effect
  window.addEventListener('scroll', function() {
      const nav = document.querySelector('nav');
      if (window.scrollY > 50) {
          nav.style.background = 'rgba(0,0,0,0.98)';
          nav.style.borderBottomColor = 'rgba(0, 212, 255, 0.2)';
      } else {
          nav.style.background = 'rgba(0,0,0,0.95)';
          nav.style.borderBottomColor = 'rgba(255,255,255,0.1)';
      }
  });


  // Foco que sigue al cursor (sólo con ratón)
  if (window.matchMedia('(hover:hover)').matches) {
    document.querySelectorAll('.pqc, .vscard, .obra, .alcbox').forEach(function(c){
      c.addEventListener('mousemove', function(ev){
        var r = c.getBoundingClientRect();
        c.style.setProperty('--mx', (ev.clientX - r.left) + 'px');
        c.style.setProperty('--my', (ev.clientY - r.top) + 'px');
      });
    });
  }

  // Detalles opcionales del formulario
  var vm = document.getElementById('verMas');
  if (vm) {
    vm.addEventListener('click', function(){
      var ex = document.getElementById('extra');
      ex.classList.toggle('open');
      vm.textContent = ex.classList.contains('open') ? '− Ocultar detalles' : '+ Añadir detalles del proyecto (opcional)';
    });
  }

  // FAQ: una abierta a la vez
  document.querySelectorAll('.fitem').forEach(function(it){
    it.addEventListener('toggle', function(){
      if (it.open) document.querySelectorAll('.fitem').forEach(function(o){ if(o!==it) o.open=false; });
    });
  });

  // Ocultar dock al llegar al formulario
  var dock = document.querySelector('.dock'), formSec = document.getElementById('presupuesto');
  if (dock && formSec && 'IntersectionObserver' in window) {
    new IntersectionObserver(function(en){
      dock.style.transform = en[0].isIntersecting ? 'translateY(120%)' : 'translateY(0)';
    }, {threshold:.15}).observe(formSec);
  }

  // Revelado al hacer scroll
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(es){
      es.forEach(function(e,i){ if(e.isIntersecting){ setTimeout(function(){e.target.classList.add('on')}, i*70); io.unobserve(e.target);} });
    }, {threshold:.12, rootMargin:'0px 0px -40px 0px'});
    document.querySelectorAll('.rv').forEach(function(el){ io.observe(el); });
  } else {
    document.querySelectorAll('.rv').forEach(function(el){ el.classList.add('on'); });
  }

  // Barra de progreso y relleno del timeline
  var prog = document.getElementById('prog');
  var tl = document.querySelector('.tl');
  function onScroll(){
    var d = document.documentElement;
    var pc = d.scrollTop / (d.scrollHeight - d.clientHeight) * 100;
    if (prog) prog.style.width = pc + '%';
    if (tl) {
      var r = tl.getBoundingClientRect(), vh = window.innerHeight;
      var f = Math.min(100, Math.max(0, ((vh*0.75 - r.top) / r.height) * 100));
      tl.style.setProperty('--fill', f + '%');
    }
  }
  window.addEventListener('scroll', onScroll, {passive:true});
  onScroll();

  // Contador numérico
  document.querySelectorAll('.d .n').forEach(function(el){
    var raw = el.textContent, num = parseFloat(raw.replace(/[^\d,.]/g,'').replace('.',''));
    if (!num || !('IntersectionObserver' in window)) return;
    var pre = raw.startsWith('~') ? '~' : '', done = false;
    new IntersectionObserver(function(es,ob){
      if (!es[0].isIntersecting || done) return;
      done = true; ob.disconnect();
      var t0 = null;
      function tick(ts){
        if (!t0) t0 = ts;
        var p = Math.min(1, (ts - t0) / 900), v = Math.round(num * (1 - Math.pow(1-p,3)));
        el.textContent = pre + v.toLocaleString('es-ES');
        if (p < 1) requestAnimationFrame(tick); else el.textContent = raw;
      }
      requestAnimationFrame(tick);
    }, {threshold:.5}).observe(el);
  });

  // Cookies & Analytics
  function setCookieConsent(accepted) {
      const expires = new Date();
      expires.setFullYear(expires.getFullYear() + 1);
      document.cookie = 'cookie_consent=' + (accepted ? 'accepted' : 'rejected') + ';expires=' + expires.toUTCString() + ';path=/;SameSite=Lax';
      document.getElementById('cookieBanner').classList.remove('active');
      if (accepted) loadAnalytics();
  }
  function getCookieConsent() {
      const match = document.cookie.match(/cookie_consent=([^;]+)/);
      return match ? match[1] : null;
  }
  function loadAnalytics() {
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-MWTDJLNC');
  }

  // ═══ Seguimiento de conversiones (dataLayer para GTM) ═══
  window.dataLayer = window.dataLayer || [];

  document.addEventListener('DOMContentLoaded', function() {
      // Cierre del menú móvil
      document.querySelectorAll('.mobile-menu-link').forEach(link => {
          link.addEventListener('click', () => {
              const menu = document.getElementById('mobileMenu');
              const hamburger = document.querySelector('.hamburger');
              if (menu) menu.classList.remove('active');
              if (hamburger) hamburger.classList.remove('active');
              document.body.style.overflow = '';
          });
      });
      const mobileMenu = document.getElementById('mobileMenu');
      if (mobileMenu) {
          mobileMenu.addEventListener('click', function(e) {
              if (e.target === this) toggleMenu();
          });
      }

      // Cookies
      const consent = getCookieConsent();
      if (!consent) {
          document.getElementById('cookieBanner').classList.add('active');
      } else if (consent === 'accepted') {
          loadAnalytics();
      }

      // Envío del formulario
      var f = document.querySelector('form[name="presupuesto-instalaciones"]');
      if (f) {
          f.addEventListener('submit', function() {
              var tipo = f.querySelector('[name="tipo-proyecto"]');
              var plazo = f.querySelector('[name="plazo"]');
              window.dataLayer.push({
                  event: 'form_submit',
                  form_name: 'presupuesto-instalaciones',
                  pagina: 'instalaciones',
                  tipo_proyecto: tipo ? tipo.value : '',
                  plazo: plazo ? plazo.value : ''
              });
          });
      }

      // Clics en teléfono, WhatsApp y email
      document.querySelectorAll('[data-canal]').forEach(function(a) {
          a.addEventListener('click', function() {
              window.dataLayer.push({
                  event: 'contacto_click',
                  canal: a.getAttribute('data-canal'),
                  pagina: 'instalaciones'
              });
          });
      });

      // Profundidad de lectura
      var hitos = [25, 50, 75, 100], vistos = [];
      window.addEventListener('scroll', function() {
          var d = document.documentElement;
          var pc = Math.round(d.scrollTop / (d.scrollHeight - d.clientHeight) * 100);
          hitos.forEach(function(x) {
              if (pc >= x && vistos.indexOf(x) === -1) {
                  vistos.push(x);
                  window.dataLayer.push({ event: 'scroll_depth', porcentaje: x, pagina: 'instalaciones' });
              }
          });
      }, { passive: true });
  });
</script>
