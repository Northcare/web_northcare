<style>
:root{
  --bg:#000; --bg2:#0b0b0b; --card:#181818; --card2:#141414;
  --white:#fff; --gray:#8b8b8b; --gray2:#c9c9c9;
  --cyan:#00d4ff; --green:#00ff88; --red:#ff4d4d; --yellow:#ffcc00; --purple:#c39bff; --orange:#ff8a3d;
  --f:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{background:var(--bg);color:var(--white);font-family:var(--f);line-height:1.6}

section{padding:4rem 1.5rem;position:relative}
.in{max-width:760px;margin:0 auto}
@media(min-width:900px){ section{padding:6rem 2rem} }

.gh{position:absolute;top:1.5rem;right:1.5rem;font-size:4rem;font-weight:900;
    color:rgba(255,255,255,.035);letter-spacing:-.05em;line-height:1;pointer-events:none}
.eyebrow{display:block;font-size:.72rem;font-weight:900;letter-spacing:.18em;
    text-transform:uppercase;color:var(--cyan);margin-bottom:1rem}
h2{font-size:clamp(1.7rem,5vw,2.3rem);font-weight:900;letter-spacing:-.03em;
    line-height:1.15;margin-bottom:1rem}
h2 .hl{color:var(--cyan)} h2 .hlv{color:var(--green)}
.intro{font-size:1.08rem;color:var(--gray2);line-height:1.8;margin-bottom:2rem}
.intro b{color:var(--white)}
p{font-size:1.02rem;color:var(--gray);line-height:1.8}
p b{color:var(--white)}
.sep{height:1px;background:rgba(255,255,255,.07);margin:0 1.5rem}

/* portada */
.hero{min-height:92svh;display:flex;flex-direction:column;justify-content:center;
    background:radial-gradient(120% 70% at 50% 0%,rgba(0,212,255,.09),transparent 60%)}
.marca{display:flex;align-items:center;gap:.8rem;margin-bottom:2.5rem}
.marca svg{width:44px;height:44px;flex-shrink:0}
.marca b{display:block;font-size:1.4rem;font-weight:900;letter-spacing:.02em;line-height:1.1}
.marca span{display:block;font-size:.7rem;font-weight:700;letter-spacing:.13em;
    text-transform:uppercase;color:var(--gray);margin-top:.15rem}
.hero h1{font-size:clamp(2rem,6.5vw,3rem);font-weight:900;letter-spacing:-.035em;
    line-height:1.12;margin-bottom:1.4rem}
.hero h1 em{font-style:normal;color:var(--cyan)}
.hero .sub{font-size:1.12rem;color:var(--gray2);line-height:1.8;margin-bottom:2rem}
.hero .sub b{color:var(--white)}
.para{padding:1rem 1.2rem;border-radius:14px;background:rgba(0,212,255,.07);
    border:1px solid rgba(0,212,255,.28);font-size:.95rem;color:var(--cyan);font-weight:700}


.hero-gan{display:grid;gap:.7rem;margin:1.75rem 0 2rem}
.hg{display:flex;gap:.85rem;align-items:flex-start;padding:1.05rem 1.15rem;border-radius:14px;
    background:rgba(0,255,136,.055);border:1px solid rgba(0,255,136,.26)}
.hg i{font-style:normal;font-size:1.15rem;font-weight:900;color:var(--green);line-height:1.3;flex-shrink:0}
.hg b{display:block;font-size:1.02rem;font-weight:800;color:var(--white);line-height:1.4}
.hg span{display:block;font-size:.93rem;color:var(--gray);line-height:1.6;margin-top:.2rem}
@media(min-width:700px){ .hero-gan{grid-template-columns:1fr 1fr} }

/* tarjetas */
.vlist{display:flex;flex-direction:column;gap:1rem}
.vc{padding:1.6rem;background:var(--card);border:1px solid rgba(255,255,255,.08);border-radius:18px}
.vc .n{display:flex;align-items:center;gap:.7rem;margin-bottom:.85rem}
.vc .n i{font-style:normal;display:inline-flex;align-items:center;justify-content:center;
    min-width:34px;height:34px;padding:0 .45rem;border-radius:10px;
    font-size:.95rem;font-weight:900;letter-spacing:-.01em;
    background:rgba(0,212,255,.12);border:1px solid rgba(0,212,255,.34);color:var(--cyan)}
.vc .n b{font-size:.92rem;font-weight:900;letter-spacing:.13em;text-transform:uppercase;color:var(--cyan)}
.vc.g .n i{background:rgba(0,255,136,.12);border-color:rgba(0,255,136,.34);color:var(--green)}
.vc.g .n b{color:var(--green)}
.vc.r .n i{background:rgba(255,77,77,.12);border-color:rgba(255,77,77,.34);color:var(--red)}
.vc.r .n b{color:var(--red)}
.vc.p .n i{background:rgba(195,155,255,.12);border-color:rgba(195,155,255,.34);color:var(--purple)}
.vc.p .n b{color:var(--purple)}
.vc h3{font-size:1.3rem;font-weight:900;line-height:1.28;margin-bottom:.85rem;letter-spacing:-.01em}
.vc p{font-size:.99rem}
.vc p+p{margin-top:.65rem}
.vc.g{border-top:3px solid var(--green)} .vc.g .n{color:var(--green)}
.vc.c{border-top:3px solid var(--cyan)}
.vc.p{border-top:3px solid var(--purple)} .vc.p .n{color:var(--purple)}
.vc.r{border-top:3px solid var(--red)} .vc.r .n{color:var(--red)}

/* cifras */
.cifras{display:grid;grid-template-columns:1fr 1fr;gap:.8rem;margin:1.75rem 0}
.cf{padding:1.3rem 1rem;background:var(--card2);border:1px solid rgba(255,255,255,.09);border-radius:14px;text-align:center}
.cf .n{display:block;font-size:1.9rem;font-weight:900;letter-spacing:-.03em;line-height:1;
    background:linear-gradient(135deg,var(--cyan),var(--green));-webkit-background-clip:text;
    background-clip:text;-webkit-text-fill-color:transparent}
.cf .l{display:block;font-size:.88rem;color:var(--gray);line-height:1.45;margin-top:.5rem}
@media(min-width:700px){ .cifras{grid-template-columns:repeat(4,1fr)} }

/* pedimos / no pedimos */
.pide{display:flex;gap:1rem;padding:1.4rem;border-radius:16px;align-items:flex-start;
    background:rgba(0,255,136,.05);border:1px solid rgba(0,255,136,.25);border-left:3px solid var(--green)}
.pide i{font-style:normal;display:inline-flex;align-items:center;justify-content:center;
    min-width:38px;height:38px;border-radius:11px;font-size:1rem;font-weight:900;flex-shrink:0;
    background:rgba(0,255,136,.12);border:1px solid rgba(0,255,136,.34);color:var(--green)}
.pide h4{font-size:1.18rem;font-weight:900;margin-bottom:.5rem;line-height:1.32}
.pide p{font-size:.97rem}
.nopide{display:flex;gap:1rem;padding:1.3rem;border-radius:16px;align-items:flex-start;
    background:rgba(255,255,255,.025);border:1px solid rgba(255,255,255,.09);border-left:3px solid var(--gray)}
.nopide i{font-style:normal;font-size:1.25rem;font-weight:900;color:var(--gray);line-height:1.1;flex-shrink:0}
.nopide h4{font-size:1.12rem;font-weight:900;margin-bottom:.4rem;color:var(--white);line-height:1.32}
.nopide p{font-size:.95rem}

/* fases */
.fase{display:flex;gap:1.1rem;padding:1.4rem;background:var(--card);
    border:1px solid rgba(255,255,255,.08);border-radius:16px}
.fase .num{width:40px;height:40px;border-radius:11px;flex-shrink:0;display:flex;
    align-items:center;justify-content:center;font-size:1rem;font-weight:900;
    background:rgba(0,212,255,.12);border:1px solid rgba(0,212,255,.34);color:var(--cyan)}
.fase h4{font-size:1.14rem;font-weight:900;margin-bottom:.4rem;line-height:1.32}
.fase .cuando{display:inline-block;margin-left:.5rem;padding:.2rem .65rem;border-radius:100px;
    font-size:.78rem;font-weight:800;background:rgba(255,255,255,.07);color:var(--gray2);vertical-align:middle}
.fase p{font-size:.96rem}

/* aviso */
.aviso{margin-top:1.5rem;padding:1.5rem;border-radius:16px;background:rgba(255,204,0,.05);
    border:1px solid rgba(255,204,0,.28);border-left:3px solid var(--yellow)}
.aviso b{display:block;font-size:1.05rem;margin-bottom:.55rem;color:var(--yellow)}
.aviso p{font-size:.98rem;color:var(--gray2)}
.aviso p+p{margin-top:.6rem}

.cierre{padding:2rem 1.5rem;border-radius:20px;text-align:center;
    background:linear-gradient(150deg,rgba(0,212,255,.1),rgba(0,255,136,.03));
    border:1px solid rgba(0,212,255,.3);margin-top:2rem}
.cierre p{font-size:1.25rem;font-weight:900;line-height:1.4;color:var(--white)}
.cierre p em{font-style:normal;color:var(--cyan)}
.cierre .d{font-size:1rem;font-weight:500;color:var(--gray2);margin-top:.8rem;line-height:1.7}


@media(max-width:700px){
  section{padding:3.25rem 1.15rem}
  h2{font-size:clamp(1.55rem,6.5vw,2rem);line-height:1.18}
  .intro{font-size:1.02rem;line-height:1.85}
  p{font-size:1rem;line-height:1.85}
  .vc{padding:1.35rem}
  .vc h3{font-size:1.16rem;line-height:1.32}
  .vc p{font-size:1rem;line-height:1.85}
  .vc .n b{font-size:.88rem;letter-spacing:.12em}
  .vc .n i{min-width:32px;height:32px;font-size:.9rem}
  .vc h3{font-size:1.22rem}
  .vc .ilu{margin-left:-.3rem;margin-right:-.3rem;padding:.75rem}
  .gh{font-size:3rem;top:1.1rem;right:1.1rem}
  .eyebrow{font-size:.7rem;letter-spacing:.15em}
  .hero h1{font-size:clamp(1.95rem,8.5vw,2.6rem)}
  .hero .sub{font-size:1.05rem;line-height:1.85}
  .hg{padding:.95rem 1rem}
  .hg b{font-size:1rem} .hg span{font-size:.94rem;line-height:1.65}
  .cifras{gap:.65rem}
  .cf{padding:1.1rem .75rem}
  .cf .n{font-size:1.7rem} .cf .l{font-size:.86rem}
  .pide,.nopide,.fase{padding:1.2rem}
  .pide p,.nopide p,.fase p{font-size:.99rem;line-height:1.8}
  .aviso{padding:1.25rem} .aviso p{font-size:1rem;line-height:1.8}
  .cierre{padding:1.75rem 1.25rem}
  .cierre p{font-size:1.14rem} .cierre .d{font-size:.99rem}
  .vlist{gap:1.15rem}
  .si{padding:1.25rem 1.15rem}
  .si p{font-size:1.04rem;line-height:1.82}
  .si i{font-size:.72rem;letter-spacing:.14em}
  .acuerdo{padding:1.35rem 1.2rem}
  .acuerdo h3{font-size:1.2rem;line-height:1.35}
  .acuerdo li{font-size:1.02rem;line-height:1.8;padding:.7rem 0}
  .acuerdo .fin{font-size:.99rem;line-height:1.8}
  .sint{gap:.85rem}
}


/* síntesis y siguiente paso */
.sint{display:flex;flex-direction:column;gap:1rem;margin:1.75rem 0 2rem}
.si{padding:1.4rem 1.35rem;border-radius:16px;background:var(--card2);
    border:1px solid rgba(255,255,255,.09);border-left:3px solid var(--cyan)}
.si.v{border-left-color:var(--green)}
.si i{display:block;font-style:normal;font-size:.74rem;font-weight:900;letter-spacing:.16em;
    text-transform:uppercase;color:var(--cyan);margin-bottom:.6rem}
.si.v i{color:var(--green)}
.si p{font-size:1.06rem;line-height:1.8;margin:0;color:var(--gray2)}
.si b{color:var(--white)}
.acuerdo{padding:1.6rem 1.4rem;border-radius:18px;margin-top:1.5rem;
    background:linear-gradient(150deg,rgba(0,255,136,.09),transparent);
    border:1px solid rgba(0,255,136,.32);border-left:4px solid var(--green)}
.acuerdo .lb{display:block;font-size:.75rem;font-weight:900;letter-spacing:.14em;
    text-transform:uppercase;color:var(--green);margin-bottom:.75rem}
.acuerdo h3{font-size:1.32rem;font-weight:900;line-height:1.35;margin-bottom:.9rem}
.acuerdo ol{list-style:none;counter-reset:a;margin-top:1rem}
.acuerdo li{counter-increment:a;display:flex;gap:.9rem;padding:.75rem 0;font-size:1.04rem;
    color:var(--gray2);line-height:1.8}
.acuerdo li::before{content:counter(a);flex-shrink:0;width:24px;height:24px;border-radius:8px;
    display:flex;align-items:center;justify-content:center;font-size:.75rem;font-weight:900;
    background:rgba(0,255,136,.12);color:var(--green);margin-top:.15rem}
.acuerdo .fin{margin-top:1.1rem;padding-top:1rem;border-top:1px solid rgba(255,255,255,.1);
    font-size:.98rem;color:var(--gray);line-height:1.7}

footer{padding:2.5rem 1.5rem;border-top:1px solid rgba(255,255,255,.08);
    text-align:center;font-size:.92rem;color:var(--gray);line-height:1.8}

.ilus{margin:1.75rem auto;padding:1.2rem;border-radius:18px;
    background:linear-gradient(150deg,#0e0e0e,#151515);border:1px solid rgba(255,255,255,.08)}
.ilus svg{width:100%;max-width:420px;height:auto;display:block;margin:0 auto}
.vc .ilu{margin:.35rem -.4rem 1.25rem;padding:1rem;border-radius:14px;
    background:linear-gradient(150deg,#0d0d0d,#151515);border:1px solid rgba(255,255,255,.06)}
.vc .ilu svg{width:100%;max-width:360px;height:auto;display:block;margin:0 auto}
</style>
